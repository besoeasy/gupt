{
  "name": "gupt",
  "version": "2026.1120.1",
  "description": "Self-hosted, end-to-end encrypted messenger. A privacy-first alternative to Telegram, Signal, WhatsApp & Discord — built on decentralized relays with WebRTC calls.",
  "homepage": "https://gupt.app",
  "license": "CC-BY-NC-4.0",
  "author": {
    "name": "besoeasy",
    "url": "https://besoeasy.com"
  },
  "bin": {
    "gupt": "bin/gupt.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "start": "node bin/gupt.js",
    "dev": "vite --host",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "build:flatpak": "BUILD_TARGET=flatpak vite build",
    "flatpak:dev": "flatpak-builder --force-clean --repo=repo build-dir flatpak/com.besoeasy.gupt.dev.yaml"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "blobatar": "2.7.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "fake-indexeddb": "^6.2.8",
    "oxfmt": "^0.79.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
