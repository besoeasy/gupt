{
  "name": "gupt",
  "version": "4.0.21",
  "description": "Self-hosted, end-to-end encrypted messenger. A privacy-first alternative to Telegram, Signal, WhatsApp & Discord — built on decentralized relays with WebRTC calls.",
  "homepage": "https://gupt.app",
  "license": "CC-BY-NC-4.0",
  "author": {
    "name": "besoeasy",
    "url": "https://besoeasy.com"
  },
  "bin": {
    "gupt": "bin/gupt.js"
  },
  "workspaces": [
    "sdk"
  ],
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "start": "node bin/gupt.js",
    "dev": "oxfmt src/ && vite --host",
    "test": "npm run test:app && npm run test:sdk",
    "test:app": "node --test \"test/*.test.mjs\"",
    "test:sdk": "npm test -w gupt-sdk",
    "build": "vite build",
    "build:flatpak": "BUILD_TARGET=flatpak vite build",
    "flatpak:dev": "flatpak-builder --force-clean --repo=repo build-dir flatpak/com.besoeasy.gupt.dev.yaml"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "dexie": "^4.3.0",
    "dompurify": "^3.4.12",
    "jdenticon": "^3.3.0",
    "jsqr": "^1.4.0",
    "marked": "^18.0.6",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "oxfmt": "^0.35.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
