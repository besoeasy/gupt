{
  "name": "gupt",
  "version": "2026.11.27",
  "description": "End-to-end encrypted privacy suite in your browser: chat, WebRTC calls, files, passwords, notes and bookmarks. No phone number, email or account — just a keypair your device derives, on self-hostable relays that only ever see ciphertext.",
  "homepage": "https://gupt.app",
  "license": "CC-BY-NC-4.0",
  "author": {
    "name": "besoeasy",
    "url": "https://besoeasy.com"
  },
  "bin": {
    "gupt": "bin/gupt.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "start": "node bin/gupt.js",
    "dev": "vite --host",
    "test": "node --test test/*.test.js",
    "format": "oxfmt",
    "format:check": "oxfmt --list-different",
    "build": "vite build",
    "release:check": "npm run format:check && node scripts/release.mjs check",
    "release:bump": "node scripts/release.mjs bump",
    "release:metainfo": "node scripts/release.mjs stamp-flatpak",
    "build:flatpak": "BUILD_TARGET=flatpak vite build",
    "flatpak:dev": "flatpak-builder --force-clean --repo=repo build-dir flatpak/com.besoeasy.gupt.dev.yaml"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "fake-indexeddb": "^6.2.8",
    "oxfmt": "^0.79.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
