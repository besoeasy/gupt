{
  "name": "gupt",
  "version": "2026.7.3-0816",
  "description": "Self-hosted, end-to-end encrypted messenger. A privacy-first alternative to Telegram, Signal, WhatsApp & Discord — built on Nostr relays with WebRTC calls.",
  "homepage": "https://gupt.app",
  "author": {
    "name": "GUPT",
    "email": "hello@gupt.app"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "gupt": "bin/gupt.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "start": "node bin/gupt.js",
    "prepare": "npm run build",
    "release": "node tag.js && npm run build",
    "dev": "oxfmt src/ && vite --host",
    "build": "vite build",
    "build:flatpak": "BUILD_TARGET=flatpak vite build",
    "flatpak:dev": "flatpak-builder --force-clean --repo=repo build-dir flatpak/com.besoeasy.gupt.dev.yaml",
    "preview": "vite preview",
    "ping": "node ping.js"
  },
  "dependencies": {
    "@dicebear/bottts-neutral": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@helia/verified-fetch": "^8.0.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/vue-virtual": "^3.13.29",
    "dexie": "^4.3.0",
    "lucide-vue-next": "^0.577.0",
    "nostr-tools": "^2.23.3",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "oxfmt": "^0.35.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0 || >=24.0.0"
  }
}
